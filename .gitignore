# 个人数据兜底（忽略内容，保留 .gitkeep 占位）
raw/**
!raw/**/
!raw/**/.gitkeep
wiki/**
!wiki/**/
!wiki/**/.gitkeep
!wiki/index.md
inbox/**
!inbox/**/
!inbox/**/.gitkeep
log/**
!log/**/
!log/**/.gitkeep
lint/**
!lint/**/
!lint/**/.gitkeep
.archive/**
!.archive/**/
!.archive/**/.gitkeep
.snapshots/
output/**
!output/**/
!output/.gitkeep
skills/**
!skills/**/
!skills/**/.gitkeep

# .obsidian/ 个人数据
.obsidian/workspace.json
.obsidian/workspace-*.json
.obsidian/workspaces.json
.obsidian/bookmarks.json
.obsidian/graph.json
.obsidian/command-palette.json
.obsidian/global-search.json
.obsidian/query.json
.obsidian/surfing-bookmark.json

# .obsidian/plugins/ 排除 node_modules 和冲突文件
.obsidian/plugins/**/node_modules/
.obsidian/plugins/**/data-冲突-*

# .claudian/ 个人数据
.claudian/sessions/

